{
  "name": "diffreview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "diffreview": "dist/server/cli.js",
    "diffreview-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "dev": "concurrently -n server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts . --port 4777",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/cli.ts src/mcp/server.ts --bundle --platform=node --format=esm --splitting --packages=external --outdir=dist --banner:js='#!/usr/bin/env node'",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.8.0",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "effect": "4.0.0-rc.112",
    "parse-diff": "^0.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
